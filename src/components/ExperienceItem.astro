---
interface Props {
	role: string;
	company: string;
	period: string;
	href?: string;
	note?: string;
	summary?: string;
	points: (string | { lead: string; text: string })[];
}

const { role, company, period, href, note, summary, points } = Astro.props;
---

<div class="py-5 first:pt-0">
	<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
		<h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
			{role}
		</h3>
		<span class="shrink-0 whitespace-nowrap text-sm text-zinc-500 dark:text-zinc-500">{period}</span>
	</div>
	<p class="mb-2 text-zinc-500 dark:text-zinc-400">
		{href ? (
			<a
				href={href}
				class="underline decoration-zinc-300 underline-offset-2 hover:text-zinc-700 hover:decoration-zinc-500 dark:decoration-zinc-600 dark:hover:text-zinc-200 transition-colors"
				rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
				target={href.startsWith('http') ? '_blank' : undefined}
			>
				{company}
			</a>
		) : (
			company
		)}
		{note && <span> · {note}</span>}
	</p>
	{summary && (
		<p class="text-zinc-600 dark:text-zinc-400 mb-2">{summary}</p>
	)}
	<ul class="space-y-1 ml-0 list-none">
		{points.map((point) => (
			<li class="text-zinc-600 dark:text-zinc-400 flex items-start">
				<span class="mr-2 text-zinc-400 dark:text-zinc-600">⚬</span>
				{typeof point === 'string' ? (
					<span>{point}</span>
				) : (
					<span><strong class="font-medium text-zinc-700 dark:text-zinc-300">{point.lead}</strong> {point.text}</span>
				)}
			</li>
		))}
	</ul>
</div>
