---
interface Props {
	degree: string;
	school: string;
	period: string;
	details?: string;
}

const { degree, school, period, details } = Astro.props;
---

<div class="py-4 first:pt-0">
	<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
		<h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
			{degree}
		</h3>
		<span class="shrink-0 whitespace-nowrap text-sm text-zinc-500 dark:text-zinc-500">{period}</span>
	</div>
	<p class="text-zinc-500 dark:text-zinc-400">{school}</p>
	{details && (
		<p class="text-zinc-600 dark:text-zinc-400 mt-1">{details}</p>
	)}
</div>
