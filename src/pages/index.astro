---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkList from '../components/LinkList.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import EducationItem from '../components/EducationItem.astro';
import AdditionalInfoItem from '../components/AdditionalInfoItem.astro';
import siteData from '../content/site.json';

const { name, tagline, location, links, about, skills, experience, freelance, education, additionalInfo } = siteData;
---

<BaseLayout title={name} description={tagline}>
	<header class="mb-16">
		<h1 class="mb-4 text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 md:text-5xl">
			{name}
		</h1>
		<p class="mb-2 text-lg text-zinc-600 dark:text-zinc-400">
			{tagline}
		</p>
		{location && (
			<p class="text-sm text-zinc-500 dark:text-zinc-500">
				{location}
			</p>
		)}
	</header>

	{about && (
		<section class="mb-16 border-t border-zinc-200 pt-12 dark:border-zinc-800">
			<h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">About</h2>
			<div class="prose prose-zinc dark:prose-invert max-w-none">
				<p class="text-zinc-700 dark:text-zinc-300 leading-relaxed">
					{about}
				</p>
			</div>
		</section>
	)}

	{experience && experience.length > 0 && (
		<section class="mb-16 border-t border-zinc-200 pt-12 dark:border-zinc-800">
			<h2 class="mb-6 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Experience</h2>
			<div class="space-y-0">
				{experience.map((item) => (
					<ExperienceItem
						role={item.role}
						company={item.company}
						period={item.period}
						href={item.href}
						note={item.note}
						summary={item.summary}
						points={item.points}
					/>
				))}
			</div>
		</section>
	)}

	{freelance && freelance.length > 0 && (
		<section class="mb-16 border-t border-zinc-200 pt-12 dark:border-zinc-800">
			<h2 class="mb-6 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Freelance</h2>
			<div class="space-y-0">
				{freelance.map((item) => (
					<ExperienceItem
						role={item.role}
						company={item.company}
						period={item.period}
						href={item.href}
						note={item.note}
						points={item.points}
					/>
				))}
			</div>
		</section>
	)}

	{education && education.length > 0 && (
		<section class="mb-16 border-t border-zinc-200 pt-12 dark:border-zinc-800">
			<h2 class="mb-6 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Education</h2>
			<div class="space-y-0">
				{education.map((item) => (
					<EducationItem
						degree={item.degree}
						school={item.school}
						period={item.period}
						details={item.details}
					/>
				))}
			</div>
		</section>
	)}

	{skills && skills.length > 0 && (
		<section class="mb-16 border-t border-zinc-200 pt-12 dark:border-zinc-800">
			<h2 class="mb-6 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Skills</h2>
			<ul class="space-y-1">
				{skills.map((skill) => (
					<li class="text-zinc-600 dark:text-zinc-400">
						<span class="font-medium text-zinc-700 dark:text-zinc-300">{skill.title}:</span> {skill.items}
					</li>
				))}
			</ul>
		</section>
	)}

	{additionalInfo && additionalInfo.length > 0 && (
		<section class="mb-16 border-t border-zinc-200 pt-12 dark:border-zinc-800">
			<h2 class="mb-6 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Additional info</h2>
			<div class="space-y-0">
				{additionalInfo.map((item) => (
					<AdditionalInfoItem
						title={item.title}
						period={item.period}
						href={item.href}
						details={item.details}
						points={item.points}
					/>
				))}
			</div>
		</section>
	)}

	<section class="mb-16 border-t border-zinc-200 pt-12 dark:border-zinc-800">
		<h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">Links</h2>
		<LinkList links={links} />
	</section>
</BaseLayout>
